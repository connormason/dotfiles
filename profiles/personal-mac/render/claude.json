{
  "$unmanaged": ["tui"],
  "model": "sonnet",
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "hooks": {
    "Notification": [{"hooks": [{"command": "$HOME/.config/iterm2/cc-status", "type": "command"}]}],
    "PermissionRequest": [{"hooks": [{"command": "$HOME/.config/iterm2/cc-status", "type": "command"}]}],
    "PostToolUse": [{"hooks": [{"command": "$HOME/.config/iterm2/cc-status", "type": "command"}]}],
    "PreToolUse": [{"hooks": [{"command": "$HOME/.config/iterm2/cc-status", "type": "command"}]}],
    "SessionEnd": [{"hooks": [{"command": "$HOME/.config/iterm2/cc-status", "type": "command"}]}],
    "SessionStart": [{"hooks": [{"command": "$HOME/.config/iterm2/cc-status", "type": "command"}]}],
    "Stop": [{"hooks": [{"command": "$HOME/.config/iterm2/cc-status", "type": "command"}]}],
    "StopFailure": [{"hooks": [{"command": "$HOME/.config/iterm2/cc-status", "type": "command"}]}],
    "SubagentStop": [{"hooks": [{"command": "$HOME/.config/iterm2/cc-status", "type": "command"}]}],
    "UserPromptSubmit": [{"hooks": [{"command": "$HOME/.config/iterm2/cc-status", "type": "command"}]}]
  }
}
