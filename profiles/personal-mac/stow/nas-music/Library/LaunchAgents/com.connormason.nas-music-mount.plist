<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.connormason.nas-music-mount</string>

    <!-- launchd does not expand ~ or $HOME in plist values, so a shell resolves both the script and the log path -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec "$HOME/.local/bin/nas-music-mount" &gt;&gt;"$HOME/Library/Logs/nas-music-mount.log" 2&gt;&amp;1</string>
    </array>

    <!-- Mount at login, then retry every 5 minutes: covers sleep/wake, Wi-Fi changes, and NAS reboots -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
