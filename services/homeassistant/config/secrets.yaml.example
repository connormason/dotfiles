# Keys referenced with `!secret <key>` from the tracked YAML. The real secrets.yaml lives only on the Home Assistant VM
# (it is never pulled, pushed, or committed). Add a key here whenever the config starts using a new `!secret`.
#
# Docker API of the NAS (the `docker-proxy` container). No trailing slash. Use the NAS's LAN IP, not a .local name.
# nas_docker_url: http://192.168.1.10:2375
