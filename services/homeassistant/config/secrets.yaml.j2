# Template for the VM's /config/secrets.yaml. `run.py ha-push` renders it with the variables of the inventory's `nas` host
# (vault included) and uploads the result; the rendered file never enters the repo. It is the single source of truth:
# a key that exists only on the VM is removed by the next push, so add every `!secret <key>` the config uses here.
#
# Jinja2 is processed by Ansible, so a vault variable resolves exactly as in the services' env.j2 templates.

# Docker API of the NAS (the `docker-proxy` service, see services/README.md), read by Monitor Docker
nas_docker_url: "http://{{ nas_lan_ip }}:2375"
