{
  "defaultMode": "acceptEdits",
  "env": {
    "UV_DEFAULT_INDEX": "https://pypi.org/simple",
    "UV_INDEX_URL": "https://pypi.org/simple",
    "UV_NO_CONFIG": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-on-edit.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-protected-files.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(ansible-lint:*)",
      "Bash(ansible-playbook:*)",
      "Bash(awk:*)",
      "Bash(brew info:*)",
      "Bash(cat:*)",
      "Bash(cmp:*)",
      "Bash(cp:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh pr diff:*)",
      "Bash(git add:*)",
      "Bash(git check-ignore:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git worktree add:*)",
      "Bash(grep:*)",
      "Bash(hatch build:*)",
      "Bash(hatch env:*)",
      "Bash(hatch run:*)",
      "Bash(hatch version:*)",
      "Bash(head:*)",
      "Bash(interrogate:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(make:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(mypy:*)",
      "Bash(nox:*)",
      "Bash(pip3 install:*)",
      "Bash(pre-commit install-hooks:*)",
      "Bash(pre-commit run:*)",
      "Bash(pytest:*)",
      "Bash(rg:*)",
      "Bash(ruff:*)",
      "Bash(sed:*)",
      "Bash(shellcheck:*)",
      "Bash(tail:*)",
      "Bash(test:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",
      "Bash(uv sync:*)",
      "Bash(uv run:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uvx yamllint:*)",
      "Bash(wc:*)",
      "Bash(yamllint:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/environment)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.crt)",
      "Read(**/*.cert)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/vault.yaml)",
      "Read(**/vault.yml)"
    ]
  }
}
