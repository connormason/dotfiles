{
  "defaultMode": "acceptEdits",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ \"$CLAUDE_TOOL_ARG_FILE_PATH\" == *.py ]]; then uv run ruff check --fix-only \"$CLAUDE_TOOL_ARG_FILE_PATH\" 2>/dev/null; fi; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"$CLAUDE_TOOL_ARG_FILE_PATH\"; if [[ \"$f\" == *.yml || \"$f\" == *.yaml ]]; then uv run yamllint \"$f\" 2>&1 || true; fi; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_ARG_FILE_PATH\" | grep -qE '(vault_password\\.txt|/vault_password|inventory/)'; then echo 'BLOCKED: Cannot edit vault password or inventory files — these are sensitive and managed separately' >&2; exit 2; fi"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(ansible-lint:*)",
      "Bash(ansible-playbook:*)",
      "Bash(awk:*)",
      "Bash(brew info:*)",
      "Bash(cat:*)",
      "Bash(cmp:*)",
      "Bash(cp:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh pr diff:*)",
      "Bash(git add:*)",
      "Bash(git check-ignore:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git worktree add:*)",
      "Bash(grep:*)",
      "Bash(hatch build:*)",
      "Bash(hatch env:*)",
      "Bash(hatch run:*)",
      "Bash(hatch version:*)",
      "Bash(head:*)",
      "Bash(interrogate:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(make:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(mypy:*)",
      "Bash(nox:*)",
      "Bash(pip3 install:*)",
      "Bash(pre-commit install-hooks:*)",
      "Bash(pre-commit run:*)",
      "Bash(pytest:*)",
      "Bash(rg:*)",
      "Bash(ruff:*)",
      "Bash(sed:*)",
      "Bash(shellcheck:*)",
      "Bash(tail:*)",
      "Bash(test:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",
      "Bash(uv sync:*)",
      "Bash(uv run:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uvx yamllint:*)",
      "Bash(wc:*)",
      "Bash(yamllint:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/environment)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.crt)",
      "Read(**/*.cert)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/vault.yaml)",
      "Read(**/vault.yml)"
    ]
  }
}
